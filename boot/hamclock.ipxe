#!ipxe
# Replace base with your trusted deployment server. Serve generated preseed.cfg there.
set base http://192.0.2.1/hamclock
set debian https://deb.debian.org/debian/dists/trixie/main/installer-amd64/current/images/netboot/debian-installer/amd64
# Disk consent is requested once inside Debian Installer, before erasing.
echo Starting HamClock automatic installer.
kernel ${debian}/linux initrd=initrd.gz auto=true priority=critical interface=auto netcfg/disable_autoconfig=false netcfg/get_hostname=hamclock-install netcfg/get_domain=local netcfg/wireless_show_essids=manual netcfg/wireless_essid_again=AF4H netcfg/wireless_essid=AF4H netcfg/wireless_security_type=wpa netcfg/wireless_wpa=h@mradio quiet preseed/url=${base}/preseed.cfg
initrd ${debian}/initrd.gz
boot
